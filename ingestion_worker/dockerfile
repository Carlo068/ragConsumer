FROM python:3.12-slim

# OCR for scanned PDFs (KAN-77): Tesseract with Spanish and English models,
# plus the tools ocrmypdf drives (Ghostscript to rasterize/rebuild, qpdf).
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        tesseract-ocr tesseract-ocr-spa tesseract-ocr-eng ghostscript qpdf \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app ./app

EXPOSE 8001
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8001"]
