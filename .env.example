# Copy to .env, or better, let the script fill in strong random values:
#
#     python scripts/generate_env.py
#
# docker compose refuses to start if any of the secrets below is missing: there
# are no built-in defaults. Never commit the real .env.

# --- Database ---
POSTGRES_USER=ragapp
POSTGRES_DB=ragconsumer
POSTGRES_PASSWORD=<random>

# --- Object storage (MinIO) ---
# The root account is only for administration. The backend and the worker each
# use their own limited account, created automatically at startup.
MINIO_ROOT_USER=minio-root
MINIO_ROOT_PASSWORD=<random>
BACKEND_MINIO_ACCESS_KEY=rag-backend
BACKEND_MINIO_SECRET_KEY=<random>
WORKER_MINIO_ACCESS_KEY=rag-worker
WORKER_MINIO_SECRET_KEY=<random>

# --- Vector database (Qdrant) ---
QDRANT_API_KEY=<random>

# --- Web app ---
SESSION_SECRET=<random>

# Behind HTTPS, so the session cookie is never sent over plain HTTP.
# SESSION_HTTPS_ONLY=true

# --- Limits (optional; these are the defaults) ---
# Largest file a person may upload, in megabytes.
# MAX_UPLOAD_MB=50

# --- Search models (optional; these are the defaults) ---
# Chosen on the Spanish legal evaluation set (see eval/). The worker and the
# MCP server always share them. Changing either one means rebuilding every
# index: docker compose exec backend python scripts/reindex_all.py --yes
# DENSE_MODEL=jinaai/jina-embeddings-v2-base-es
# BM25_LANGUAGE=spanish

# --- Production (docker-compose.prod.yml) ---
# The public address of the server. Caddy gets the HTTPS certificate for it, so
# its DNS record must already point at the server. Required in production;
# `python scripts/generate_env.py --domain matters.yourfirm.mx` sets it.
# DOMAIN=matters.yourfirm.mx
# Largest request Caddy lets through, in megabytes (a little above MAX_UPLOAD_MB).
# MAX_REQUEST_MB=64

# --- Public addresses (set these in production) ---
# Where people open the web app; invitation links point here.
# FRONTEND_URL=https://matters.yourfirm.example
# Where AI assistants reach the MCP server.
# MCP_PUBLIC_URL=https://matters.yourfirm.example

# --- Backups (see docs/deployment/05-backups.md) ---
# Public key that encrypts every backup (starts with age1...). The matching
# PRIVATE key is kept off the server, and is needed to restore.
# BACKUP_AGE_RECIPIENT=age1...
# Off-server destination: any S3-compatible bucket (Backblaze B2, Wasabi,
# Hetzner, AWS, Cloudflare R2, ...). Backups refuse to run without one.
# BACKUP_S3_BUCKET=
# Who the provider is, for rclone (Other is fine for most; AWS, Cloudflare, Wasabi, Minio...).
# BACKUP_S3_PROVIDER=Other
# BACKUP_S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# BACKUP_S3_REGION=us-west-004
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=
# BACKUP_S3_PREFIX=ragconsumer
# Retention (defaults): every backup for 14 days, then weekly for 8 weeks,
# then monthly for 12 months.
# BACKUP_KEEP_DAILY=14
# BACKUP_KEEP_WEEKLY=8
# BACKUP_KEEP_MONTHLY=12
# Set to false if the bucket's own lifecycle rules do the deleting and the
# key you gave is not allowed to delete (protects against ransomware).
# BACKUP_PRUNE_REMOTE=true
# Lets a backup run with no off-server destination. For tests only: such a
# backup is lost together with the server.
# BACKUP_ALLOW_LOCAL_ONLY=false

# --- Monitoring and alerts (see docs/deployment/07-monitoring.md) ---
# Where the server tells people something is wrong (and when it is fixed). At
# least one is needed; both can be set.
# A Slack / Mattermost / Teams / Discord incoming webhook:
# ALERT_WEBHOOK_URL=
# An ntfy topic (phone notifications), with a long unguessable name:
# ALERT_NTFY_URL=https://ntfy.sh/replace-with-a-long-random-name
# An outside "heartbeat" service (healthchecks.io style) pinged after every
# healthy check, so you also hear if the whole server goes silent:
# HEARTBEAT_URL=
# Limits (defaults): disk percent, hours since last backup, certificate days.
# MONITOR_DISK_MAX=85
# MONITOR_BACKUP_MAX_HOURS=26
# MONITOR_CERT_MIN_DAYS=14
# Minutes a document may wait or process with no progress before an alert.
# MONITOR_DOC_WAIT_MINUTES=90
# What the monitor calls this server in alerts (default: its hostname), how often
# it repeats a reminder while something stays broken, and whether it checks that
# last night's backup happened (leave on in production).
# MONITOR_NAME=matters-production
# MONITOR_REMIND_HOURS=6
# MONITOR_BACKUP=on
# MONITOR_STATE_DIR=/var/lib/ragconsumer-monitor
