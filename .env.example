# Copy to .env, or better, let the script fill in strong random values:
#
#     python scripts/generate_env.py
#
# docker compose refuses to start if any of the secrets below is missing: there
# are no built-in defaults. Never commit the real .env.

# --- Database ---
POSTGRES_USER=ragapp
POSTGRES_DB=ragconsumer
POSTGRES_PASSWORD=<random>

# --- Object storage (MinIO) ---
# The root account is only for administration. The backend and the worker each
# use their own limited account, created automatically at startup.
MINIO_ROOT_USER=minio-root
MINIO_ROOT_PASSWORD=<random>
BACKEND_MINIO_ACCESS_KEY=rag-backend
BACKEND_MINIO_SECRET_KEY=<random>
WORKER_MINIO_ACCESS_KEY=rag-worker
WORKER_MINIO_SECRET_KEY=<random>

# --- Vector database (Qdrant) ---
QDRANT_API_KEY=<random>

# --- Web app ---
SESSION_SECRET=<random>

# --- Public addresses (set these in production) ---
# Where people open the web app; invitation links point here.
# FRONTEND_URL=https://matters.yourfirm.example
# Where AI assistants reach the MCP server.
# MCP_PUBLIC_URL=https://matters.yourfirm.example
