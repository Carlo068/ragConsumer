[Unit]
Description=ragConsumer health check and alerts
After=docker.service network-online.target

[Service]
Type=oneshot
User=deploy
WorkingDirectory=/home/deploy/ragConsumer
StateDirectory=ragconsumer-monitor
Environment=MONITOR_STATE_DIR=/var/lib/ragconsumer-monitor
ExecStart=/bin/bash deploy/monitor.sh
TimeoutStartSec=5min
